# QDRANT
QDRANT_PORT=6333

# MINIO
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-strong-password

# LIVEKIT
LIVEKIT_PORT=7880
LIVEKIT_UDP_PORT_START=50000
LIVEKIT_UDP_PORT_END=50010
LIVEKIT_KEYS=devkey:change-this-secret
LIVEKIT_NODE_IP=127.0.0.1

# TRANSLATION
# Self-hosted chat translation service.
# Default model: OpenNMT/nllb-200-distilled-1.3B-ct2-int8
TRANSLATION_PORT=8100
TRANSLATION_MODEL_NAME=nllb-200-distilled-1.3B-ct2-int8
TRANSLATION_DEVICE=cpu
TRANSLATION_COMPUTE_TYPE=int8
TRANSLATION_DEFAULT_SOURCE_LANGUAGE=eng_Latn
TRANSLATION_MAX_CHARS=1000
TRANSLATION_MODEL_HOST_PATH=./models/nllb-200-distilled-1.3B-ct2-int8