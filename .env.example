# AOS INFRASTRUCTURE EXAMPLE
# Copy this file to .env and replace placeholders. Never commit the real .env.
# Docker log rotation
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILES=5


# EXTERNAL SERVICE JOB RETENTION
# Keeps durable service-job rows for audit while pruning bulky payload bodies.
SERVICE_JOB_CLEANUP_ENABLED=true
SERVICE_JOB_SUCCESS_PAYLOAD_RETENTION_DAYS=30
SERVICE_JOB_FAILED_PAYLOAD_RETENTION_DAYS=90
SERVICE_JOB_DELETE_SUCCESS_AFTER_DAYS=0
SERVICE_JOB_DELETE_FAILED_AFTER_DAYS=0
SERVICE_JOB_CLEANUP_LIMIT=500


# QDRANT
QDRANT_BIND_ADDRESS=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=change-this-long-random-qdrant-api-key  # pragma: allowlist secret

QDRANT_MEMORY_LIMIT=1536m
QDRANT_CPU_LIMIT=1.50
QDRANT_PIDS_LIMIT=512


# MINIO
# MinIO API and administration console remain private.
# Public file access is proxied through Nginx.
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_CONSOLE_BIND_ADDRESS=127.0.0.1

MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101

MINIO_ROOT_USER=change-this-minio-admin-user
MINIO_ROOT_PASSWORD=change-this-very-strong-minio-password
# Explicit browser origins allowed to issue direct presigned uploads to staging
# MinIO. Do not use * on shared environments. Production S3-compatible CORS is
# configured on the provider bucket through infrastructure, not AOS Settings.
MINIO_API_CORS_ALLOW_ORIGIN=https://app-staging.example.com,http://localhost:3000

# AOS Media uses provider-neutral S3-compatible object-storage configuration.
# In local/shared staging these values point at MinIO. In production point them
# at Hetzner Object Storage; AWS S3 can use the same contract later.
# Keep the public delivery/CDN URL distinct from the presign/upload origin.
AOS_OBJECT_STORAGE_ENDPOINT=127.0.0.1:9100
AOS_OBJECT_STORAGE_SECURE=false
AOS_OBJECT_STORAGE_REGION=
AOS_OBJECT_STORAGE_PATH_STYLE=true
AOS_OBJECT_STORAGE_PRESIGN_ENDPOINT=https://uploads.example.com
AOS_MEDIA_PUBLIC_BASE_URL=https://staging-media.example.com
AOS_OBJECT_STORAGE_PUBLIC_BUCKET=aos-public
AOS_OBJECT_STORAGE_PRIVATE_BUCKET=aos-private
AOS_OBJECT_STORAGE_ACCESS_KEY=change-this-media-service-access-key
AOS_OBJECT_STORAGE_SECRET_KEY=change-this-media-service-secret-key
# Development/staging may allow the Media service credential to create/configure
# its own buckets. Production should pre-provision buckets/policies and set false.
AOS_OBJECT_STORAGE_MANAGE_BUCKETS=true

# Shorts/video processing still has its own MinIO deployment configuration.
# These values are not Media's storage contract and must not be used by new Media code.
MINIO_ENDPOINT=127.0.0.1:9100
MINIO_SECURE=false
MINIO_PUBLIC_BASE_URL=https://uploads.example.com
AOS_PUBLIC_BUCKET=aos-public
AOS_PRIVATE_BUCKET=aos-private

# Media storage reliability and bounded URL lifetimes.
AOS_STORAGE_CONNECT_TIMEOUT_SECONDS=3
AOS_STORAGE_READ_TIMEOUT_SECONDS=15
AOS_STORAGE_MAX_RETRIES=2
AOS_STORAGE_RETRY_BACKOFF_MS=200
AOS_MEDIA_DOWNLOAD_EXPIRY_MINUTES=10

# Scheduled media lifecycle reconciliation/cleanup.
AOS_MEDIA_UNATTACHED_RETENTION_DAYS=7
AOS_MEDIA_DELETE_RETRY_HOURS=1
AOS_MEDIA_CLEANUP_BATCH_LIMIT=100
# Use standard Frappe queues intentionally: cheap deletion on short, expensive processing on long.
AOS_MEDIA_DELETE_QUEUE_NAME=short
AOS_MEDIA_PROCESSING_QUEUE_NAME=long
AOS_MEDIA_DELETE_JOB_TIMEOUT_SECONDS=120
AOS_MEDIA_PROCESSING_JOB_TIMEOUT_SECONDS=240
AOS_MEDIA_PROCESSING_MAX_ATTEMPTS=3
AOS_MEDIA_PROCESSING_STALE_SECONDS=600
AOS_MEDIA_PROCESSING_RECOVERY_LIMIT=100
# Resumable multipart uploads (used automatically for large Shorts videos).
# Keep active-session quotas per user bounded to prevent abandoned-upload abuse.
AOS_MEDIA_MULTIPART_ACTIVE_LIMIT_PER_USER=6
AOS_MEDIA_MULTIPART_SESSION_HOURS=24
# The API issues signed UploadPart URLs in bounded batches; clients should not
# upload more parts concurrently than this server-provided hint.
AOS_MEDIA_MULTIPART_PART_URL_BATCH_SIZE=8
AOS_MEDIA_MULTIPART_MAX_PARALLEL_PARTS=4

# MinIO independently reclaims abandoned multipart part data even if an AOS
# cleanup run is interrupted. Keep expiry at or beyond the AOS session window.
MINIO_API_STALE_UPLOADS_EXPIRY=24h
MINIO_API_STALE_UPLOADS_CLEANUP_INTERVAL=1h

MINIO_MEMORY_LIMIT=1g
MINIO_CPU_LIMIT=1.00
MINIO_PIDS_LIMIT=512


# LIVEKIT
# HTTP/WebSocket signaling remains private and is exposed through Nginx.
LIVEKIT_BIND_ADDRESS=127.0.0.1
LIVEKIT_PORT=7880

# RTC TCP fallback is accessed directly by clients.
LIVEKIT_TCP_BIND_ADDRESS=0.0.0.0
LIVEKIT_TCP_PORT=7881

# WebRTC UDP mux is accessed directly by clients.
LIVEKIT_UDP_BIND_ADDRESS=0.0.0.0
LIVEKIT_USE_EXTERNAL_IP=true

# The same key pair is used by AOS server-side token/admin calls and by
# LiveKit to sign webhook requests. Keep both values in the secret store.
LIVEKIT_KEYS="replace-api-key: replace-with-a-strong-livekit-secret"
LIVEKIT_ENDPOINT=wss://live.example.com
# Private server-to-server control plane used by Frappe workers for room admin.
# Single-host Bench + Docker baseline:
LIVEKIT_ADMIN_ENDPOINT=http://127.0.0.1:7880
LIVEKIT_API_KEY=replace-api-key
LIVEKIT_API_SECRET=replace-with-a-strong-livekit-secret
LIVEKIT_WEBHOOK_URL=https://api.example.com/api/method/aos.api.v1.livekit.handle_webhook

# Shared Redis makes LiveKit nodes fully distributed. Point every production
# node at the same managed/HA Redis endpoint; local Compose defaults below are
# suitable only for a single-host deployment.
LIVEKIT_REDIS_ADDRESS=livekit-redis:6379
LIVEKIT_REDIS_DB=0
LIVEKIT_REDIS_USERNAME=
LIVEKIT_REDIS_PASSWORD=
LIVEKIT_REDIS_TLS_ENABLED=false
# Keep false in production; set true only for an explicitly trusted private lab CA.
LIVEKIT_REDIS_TLS_INSECURE=false
LIVEKIT_REDIS_TLS_SERVER_NAME=

# Explicit room and network resource bounds. Raise only after load testing.
LIVEKIT_ROOM_MAX_PARTICIPANTS=2000
LIVEKIT_ROOM_EMPTY_TIMEOUT_SECONDS=300
LIVEKIT_ROOM_DEPARTURE_TIMEOUT_SECONDS=20
# Single UDP mux port for the Compose node. Horizontally scaled production
# should give each LiveKit node direct RTC reachability (prefer host networking).
LIVEKIT_UDP_PORT=7882
LIVEKIT_NODE_SYSLOAD_LIMIT=0.75

LIVEKIT_TURN_ENABLED=true
LIVEKIT_TURN_UDP_BIND_ADDRESS=0.0.0.0
LIVEKIT_TURN_UDP_PORT=3478
# TURN/TLS is not enabled by the single-host baseline. If your deployment
# requires TURN/TLS for restrictive networks, provision a real TURN hostname
# and trusted certificate (or dedicated L4 TLS termination) rather than using
# placeholder certificate paths in the core LiveKit container.
LIVEKIT_TURN_PER_USER_ALLOCATION_LIMIT=12
LIVEKIT_METRICS_BIND_ADDRESS=127.0.0.1
LIVEKIT_METRICS_PORT=6789

LIVEKIT_MEMORY_LIMIT=1536m
LIVEKIT_CPU_LIMIT=2.00
LIVEKIT_PIDS_LIMIT=1024
LIVEKIT_STOP_GRACE_PERIOD=300s
LIVEKIT_REDIS_MAXMEMORY=256mb
LIVEKIT_REDIS_MEMORY_LIMIT=384m
LIVEKIT_REDIS_CPU_LIMIT=0.50
LIVEKIT_REDIS_PIDS_LIMIT=256


# TRANSLATION
TRANSLATION_BIND_ADDRESS=127.0.0.1
TRANSLATION_PORT=8100

TRANSLATION_MODEL_NAME=nllb-200-distilled-1.3B-ct2-int8
TRANSLATION_DEVICE=cpu
TRANSLATION_COMPUTE_TYPE=int8
TRANSLATION_DEFAULT_SOURCE_LANGUAGE=eng_Latn
TRANSLATION_MAX_CHARS=1000
TRANSLATION_MAX_SOURCE_TOKENS=768
TRANSLATION_MAX_DECODING_LENGTH=384
TRANSLATION_BEAM_SIZE=4
TRANSLATION_MAX_CONCURRENT_REQUESTS=4
TRANSLATION_INTER_THREADS=2
TRANSLATION_INTRA_THREADS=0
# Optional defense-in-depth token. When set, backend and translation service must share it.
TRANSLATION_INTERNAL_TOKEN=

TRANSLATION_MODEL_HOST_PATH=./models/nllb-200-distilled-1.3B-ct2-int8

TRANSLATION_SERVICE_URL=http://127.0.0.1:8100

TRANSLATION_MEMORY_LIMIT=4g
TRANSLATION_CPU_LIMIT=3.00
TRANSLATION_PIDS_LIMIT=1024


# IMAGE SEARCH
# Image search remains private and is accessed only by the Frappe backend.
# It owns OpenCLIP embeddings and talks to Qdrant internally.
IMAGE_SEARCH_BIND_ADDRESS=127.0.0.1
IMAGE_SEARCH_PORT=8110

IMAGE_SEARCH_SERVICE_NAME=aos-image-search
IMAGE_SEARCH_ENVIRONMENT=production
IMAGE_SEARCH_DEBUG=false

IMAGE_SEARCH_MODEL_NAME=ViT-B-32
IMAGE_SEARCH_PRETRAINED=laion2b_s34b_b79k
IMAGE_SEARCH_DEVICE=cpu
IMAGE_SEARCH_VECTOR_SIZE=512

IMAGE_SEARCH_QDRANT_URL=http://qdrant:6333
IMAGE_SEARCH_COLLECTION=aos_ad_images_v2
IMAGE_SEARCH_EMBEDDING_VERSION=ViT-B-32:laion2b_s34b_b79k:v1
IMAGE_SEARCH_COLLECTION_SCHEMA_VERSION=2
IMAGE_SEARCH_QDRANT_API_KEY=${QDRANT_API_KEY}

IMAGE_SEARCH_LIMIT=50
IMAGE_SEARCH_MAX_LIMIT=100
IMAGE_SEARCH_SCORE_THRESHOLD=0.75
IMAGE_SEARCH_PRIMARY_BOOST=0.02

IMAGE_SEARCH_MAX_IMAGE_BYTES=10485760
IMAGE_SEARCH_REQUEST_TIMEOUT_SECONDS=15

# Shared HMAC secret for signed visual Shorts classification requests.
# Generate with: openssl rand -hex 32
SHORT_CLASSIFICATION_SECRET=change-this-long-random-short-classification-secret  # pragma: allowlist secret
IMAGE_SEARCH_SHORT_CLASSIFICATION_MAX_FRAMES=6
IMAGE_SEARCH_SHORT_CLASSIFICATION_MAX_FRAME_BYTES=1048576
IMAGE_SEARCH_SHORT_CLASSIFICATION_MAX_TOTAL_BYTES=6291456
IMAGE_SEARCH_SHORT_CLASSIFICATION_TEMPERATURE=0.05
IMAGE_SEARCH_SHORT_CLASSIFICATION_MODEL_VERSION=openclip-v1

# Used when ad images are stored as relative Frappe URLs like /files/example.jpg.
# This will become less important once Ads move fully to MinIO media_id URLs.
IMAGE_SEARCH_FILE_BASE_URL=https://api.example.com
# Comma-separated trusted hosts the image-search worker may fetch ad images from.
# IMAGE_SEARCH_FILE_BASE_URL and AOS_MEDIA_PUBLIC_BASE_URL hosts are automatically trusted.
# Add only additional exact image hosts here; wildcards are not supported.
IMAGE_SEARCH_ALLOWED_IMAGE_HOSTS=api.example.com

# AOS backend runtime Image Search service URL.
IMAGE_SEARCH_SERVICE_URL=http://127.0.0.1:8110
IMAGE_SEARCH_CLIENT_MAX_RETRIES=2
IMAGE_SEARCH_CLIENT_RETRY_BACKOFF_MS=250

IMAGE_SEARCH_MEMORY_LIMIT=4g
IMAGE_SEARCH_CPU_LIMIT=3.00
IMAGE_SEARCH_PIDS_LIMIT=1024


# BACKGROUND REMOVAL
# Background removal remains private and is accessed only by the Frappe backend.
BACKGROUND_REMOVAL_BIND_ADDRESS=127.0.0.1
BACKGROUND_REMOVAL_PORT=8120

# Internal bearer secret shared only by Frappe Media workers and this service.
# Generate with: openssl rand -hex 32
BACKGROUND_REMOVAL_SERVICE_SECRET=change-this-long-random-background-removal-secret  # pragma: allowlist secret

# The image pins REMBG_HOME=/opt/aos/rembg and bakes the reviewed U2Net
# artifact into an immutable image layer. Runtime model downloads/overrides are
# intentionally unsupported.
BACKGROUND_REMOVAL_MAX_IMAGE_BYTES=10485760
BACKGROUND_REMOVAL_MAX_IMAGE_PIXELS=16000000
BACKGROUND_REMOVAL_MAX_CONCURRENT_INFERENCES=2
BACKGROUND_REMOVAL_INFERENCE_ACQUIRE_TIMEOUT_SECONDS=1
BACKGROUND_REMOVAL_CPU_THREADS=2

# AOS backend runtime Background Removal service URL.
BACKGROUND_REMOVAL_SERVICE_URL=http://127.0.0.1:8120

BACKGROUND_REMOVAL_MEMORY_LIMIT=3g
BACKGROUND_REMOVAL_CPU_LIMIT=2.00
BACKGROUND_REMOVAL_PIDS_LIMIT=1024


# NOTIFICATION DELIVERY
NOTIFICATION_DELIVERY_ENABLED=true
NOTIFICATION_DELIVERY_FAIL_OPEN=true

NOTIFICATION_SERVICE_BIND_ADDRESS=127.0.0.1
NOTIFICATION_SERVICE_PORT=8160
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8160

NOTIFICATION_SERVICE_NAME=aos-notification-delivery
NOTIFICATION_SERVICE_ENVIRONMENT=production
NOTIFICATION_SERVICE_DEBUG=false

NOTIFICATION_SERVICE_SECRET=replace-with-a-strong-notification-dispatch-secret
NOTIFICATION_SERVICE_CALLBACK_SECRET=replace-with-a-strong-notification-callback-secret

NOTIFICATION_CALLBACK_URL=https://api.example.com/api/method/aos.api.v1.notifications.handle_delivery_callback

NOTIFICATION_FRAPPE_QUEUE=long
NOTIFICATION_SERVICE_REQUEST_TIMEOUT_SECONDS=20
NOTIFICATION_DISPATCHER_TIMEOUT_SECONDS=300
NOTIFICATION_MAX_RETRIES=3

# Notifications retention. Notification Center is a recent-event inbox, not an audit ledger.
AOS_NOTIFICATION_RETENTION_ENABLED=true
AOS_NOTIFICATION_INBOX_RETENTION_DAYS=180
AOS_NOTIFICATION_DELIVERY_SUCCESS_RETENTION_DAYS=30
AOS_NOTIFICATION_DELIVERY_FAILURE_RETENTION_DAYS=90
AOS_NOTIFICATION_RETENTION_BATCH_SIZE=1000
AOS_NOTIFICATION_RETENTION_MAX_BATCHES=20

NOTIFICATION_REDIS_URL=redis://notification-redis:6379/0
NOTIFICATION_QUEUE_NAME=notification-delivery
NOTIFICATION_REDIS_MAXMEMORY=256mb
NOTIFICATION_REDIS_MEMORY_LIMIT=384m
NOTIFICATION_REDIS_CPU_LIMIT=0.50
NOTIFICATION_REDIS_PIDS_LIMIT=256

NOTIFICATION_JOB_TIMEOUT_SECONDS=600
NOTIFICATION_DURABLE_RESULT_TTL_SECONDS=604800
NOTIFICATION_CALLBACK_JOB_TIMEOUT_SECONDS=120
NOTIFICATION_CALLBACK_MAX_ATTEMPTS=8
NOTIFICATION_RESULT_TTL_SECONDS=86400
NOTIFICATION_FAILURE_TTL_SECONDS=604800

# Set true only for local/staging smoke tests that should not call FCM.
NOTIFICATION_DRY_RUN=false
NOTIFICATION_FIREBASE_SERVICE_ACCOUNT_HOST_PATH=./secrets/firebase-service-account.json
NOTIFICATION_FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json
NOTIFICATION_MAX_TOKENS_PER_MULTICAST=500
NOTIFICATION_PROVIDER_MAX_RETRIES=3
NOTIFICATION_PROVIDER_TIMEOUT_SECONDS=20
NOTIFICATION_CALLBACK_HTTP_TIMEOUT_SECONDS=20

# Optional Firebase Web Messaging bootstrap. These values are public client
# configuration, not service-account secrets. Keep disabled until the web app
# has a production service worker and permission UX.
NOTIFICATION_WEB_PUSH_ENABLED=false
NOTIFICATION_FIREBASE_WEB_API_KEY=
NOTIFICATION_FIREBASE_WEB_AUTH_DOMAIN=
NOTIFICATION_FIREBASE_WEB_PROJECT_ID=
NOTIFICATION_FIREBASE_WEB_STORAGE_BUCKET=
NOTIFICATION_FIREBASE_WEB_MESSAGING_SENDER_ID=
NOTIFICATION_FIREBASE_WEB_APP_ID=
NOTIFICATION_FIREBASE_WEB_MEASUREMENT_ID=
NOTIFICATION_FIREBASE_WEB_VAPID_PUBLIC_KEY=

NOTIFICATION_API_MEMORY_LIMIT=512m
NOTIFICATION_API_CPU_LIMIT=1.00
NOTIFICATION_API_PIDS_LIMIT=512

NOTIFICATION_WORKER_MEMORY_LIMIT=1g
NOTIFICATION_WORKER_CPU_LIMIT=1.00
NOTIFICATION_WORKER_PIDS_LIMIT=512


# ANALYTICS PIPELINE
ANALYTICS_PIPELINE_ENABLED=true
ANALYTICS_PIPELINE_FAIL_OPEN=true

ANALYTICS_SERVICE_BIND_ADDRESS=127.0.0.1
ANALYTICS_SERVICE_PORT=8170
ANALYTICS_SERVICE_URL=http://127.0.0.1:8170

ANALYTICS_SERVICE_NAME=aos-analytics-pipeline
ANALYTICS_SERVICE_ENVIRONMENT=production
ANALYTICS_SERVICE_DEBUG=false

ANALYTICS_SERVICE_SECRET=replace-with-a-strong-analytics-dispatch-secret
ANALYTICS_SERVICE_CALLBACK_SECRET=replace-with-a-strong-analytics-callback-secret
ANALYTICS_CALLBACK_URL=https://api.example.com/api/method/aos.api.v1.analytics_pipeline.handle_callback

ANALYTICS_FRAPPE_QUEUE=long
ANALYTICS_SERVICE_REQUEST_TIMEOUT_SECONDS=20
ANALYTICS_DISPATCHER_TIMEOUT_SECONDS=300
ANALYTICS_MAX_RETRIES=3

ANALYTICS_REDIS_URL=redis://analytics-redis:6379/0
ANALYTICS_QUEUE_NAME=analytics-pipeline
ANALYTICS_REDIS_MAXMEMORY=512mb
ANALYTICS_REDIS_MEMORY_LIMIT=768m
ANALYTICS_REDIS_CPU_LIMIT=0.50
ANALYTICS_REDIS_PIDS_LIMIT=256

ANALYTICS_JOB_TIMEOUT_SECONDS=600
ANALYTICS_DURABLE_RESULT_TTL_SECONDS=604800
ANALYTICS_CALLBACK_JOB_TIMEOUT_SECONDS=120
ANALYTICS_CALLBACK_MAX_ATTEMPTS=8
ANALYTICS_EVENT_DEDUPE_TTL_SECONDS=2592000
ANALYTICS_RESULT_TTL_SECONDS=86400
ANALYTICS_FAILURE_TTL_SECONDS=604800
ANALYTICS_STREAM_MAX_LEN=500000
ANALYTICS_MAX_EVENTS_PER_JOB=200

ANALYTICS_API_MEMORY_LIMIT=512m
ANALYTICS_API_CPU_LIMIT=1.00
ANALYTICS_API_PIDS_LIMIT=512

ANALYTICS_WORKER_MEMORY_LIMIT=1g
ANALYTICS_WORKER_CPU_LIMIT=1.00
ANALYTICS_WORKER_PIDS_LIMIT=512


# GLOBAL MAPS BASEMAP
# Static basemap artifacts are PMTiles in S3-compatible object storage. Put a CDN
# in front of MAPS_PUBLIC_BASE_URL in production; AOS API containers do not serve tiles.
MAPS_PUBLIC_BASE_URL=https://maps.example.com/basemap
MAPS_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9100
MAPS_OBJECT_STORAGE_BUCKET=aos-maps
MAPS_OBJECT_STORAGE_REGION=us-east-1
MAPS_OBJECT_STORAGE_ACCESS_KEY=replace-with-dedicated-maps-access-key
MAPS_OBJECT_STORAGE_SECRET_KEY=replace-with-dedicated-maps-secret-key
# Used only by the explicit one-time/repair `publish-basemap.py --policy-only`
# operation. This identity must be able to create the Maps bucket (when absent)
# and change its bucket policy. Keep it out of the long-lived AOS/Maps runtime.
MAPS_OBJECT_STORAGE_POLICY_ACCESS_KEY=replace-with-operator-policy-access-key
MAPS_OBJECT_STORAGE_POLICY_SECRET_KEY=replace-with-operator-policy-secret-key

# PHOTON + EXTERNAL OPENSEARCH 3.x
PHOTON_BIND_ADDRESS=127.0.0.1
PHOTON_PORT=2322
PHOTON_VERSION=1.2.0
PHOTON_JAR_SHA256=3455a6c2c9828393c2506d23540015b3b220cf00f4a9bb2c39e8007971cbe8c7
PHOTON_OPENSEARCH_VERSION=3.8.0
PHOTON_OPENSEARCH_TRANSPORT_ADDRESSES=10.0.20.11:9200,10.0.20.12:9200,10.0.20.13:9200
PHOTON_OPENSEARCH_CLUSTER=photon
PHOTON_MAX_RESULTS=20
PHOTON_MAX_REVERSE_RESULTS=10
PHOTON_QUERY_TIMEOUT_SECONDS=5
PHOTON_DEFAULT_LANGUAGE=en
PHOTON_JAVA_OPTS="-Xms512m -Xmx2g -XX:+ExitOnOutOfMemoryError"
PHOTON_MEMORY_LIMIT=3g
PHOTON_MEMORY_RESERVATION=2g
PHOTON_CPU_LIMIT=2.00
PHOTON_PIDS_LIMIT=1024

# GLOBAL VALHALLA ROUTING RUNTIME (docker compose --profile maps-routing ...)
# Production Maps requires this private service. The runtime mounts only the
# verified active graph release; build/activation are separate operations jobs.
VALHALLA_BIND_ADDRESS=127.0.0.1
VALHALLA_PORT=8002
VALHALLA_THREADS=4
VALHALLA_TILESET_NAME=aos_world_valhalla
VALHALLA_GRAPH_CURRENT_PATH=./maps/valhalla/current
VALHALLA_IMAGE=ghcr.io/valhalla/valhalla-scripted@sha256:bb3e89c0e8d3fb35e9278e23a1f7fdbcbf76d29c1edbf7effad829e1ee26b6ed
VALHALLA_MEMORY_LIMIT=8g
VALHALLA_MEMORY_RESERVATION=4g
VALHALLA_CPU_LIMIT=4.00
VALHALLA_PIDS_LIMIT=2048

# OFFLINE PLANETILER BUILD JOB
PLANETILER_IMAGE=ghcr.io/onthegomap/planetiler@sha256:afa51b803e0cb5be77165bc651cdf17a9cf6b01441fa32a873ef9632f18cc75c
PLANETILER_JAVA_MEMORY=64g

# PUBLIC STAGING DOMAINS
AOS_API_DOMAIN=api.example.com
AOS_MAPS_DOMAIN=maps.example.com
AOS_LIVEKIT_DOMAIN=live.example.com
AOS_MINIO_DOMAIN=files.example.com


# FRAPPE / NGINX
FRAPPE_BENCH_PATH=/home/aos/frappe-bench

FRAPPE_WEB_HOST=127.0.0.1
FRAPPE_WEB_PORT=8000

FRAPPE_SOCKETIO_HOST=127.0.0.1
FRAPPE_SOCKETIO_PORT=9000

# Raised for media uploads.
# Direct MinIO uploads still pass through Nginx at the public files domain.
NGINX_CLIENT_MAX_BODY_SIZE=500m

NGINX_PROXY_CONNECT_TIMEOUT=10s
NGINX_PROXY_READ_TIMEOUT=60s
NGINX_PROXY_SEND_TIMEOUT=60s


# TLS
TLS_ADMIN_EMAIL=admin@example.com


# FRAPPE SITE
FRAPPE_SITE_NAME=site.example.com


# FOREIGN EXCHANGE
# Required by the Frappe FX refresh task.
FX_API_KEY=change-this-exchange-rate-api-key

# VIDEO PROCESSING SERVICE
# Video service is private and accessed by Frappe only.
VIDEO_SERVICE_BIND_ADDRESS=127.0.0.1
VIDEO_SERVICE_PORT=8130
VIDEO_SERVICE_URL=http://127.0.0.1:8130
VIDEO_SERVICE_NAME=aos-video-processing
VIDEO_SERVICE_ENVIRONMENT=production
VIDEO_SERVICE_DEBUG=false

# Shared HMAC secrets. Use long random values in real .env.
VIDEO_SERVICE_SECRET=change-this-long-random-video-dispatch-secret
VIDEO_SERVICE_CALLBACK_SECRET=change-this-long-random-video-callback-secret

# Public callback URL the video worker can reach.
VIDEO_CALLBACK_URL=https://site.example.com/api/method/aos.api.internal.video_processing.handle_callback

# Frappe dispatcher settings.
VIDEO_FRAPPE_QUEUE=long
VIDEO_SERVICE_REQUEST_TIMEOUT_SECONDS=20
VIDEO_DISPATCHER_TIMEOUT_SECONDS=300
VIDEO_MAX_RETRIES=3

# Video worker queue. This Redis belongs to the video service, not Frappe.
VIDEO_REDIS_URL=redis://video-redis:6379/0
VIDEO_QUEUE_NAME=video
VIDEO_CALLBACK_QUEUE_NAME=video-callbacks
VIDEO_WORKER_REPLICAS=2
VIDEO_CALLBACK_WORKER_REPLICAS=2
VIDEO_REDIS_MAXMEMORY=512mb
VIDEO_REDIS_MEMORY_LIMIT=768m
VIDEO_REDIS_CPU_LIMIT=0.50
VIDEO_REDIS_PIDS_LIMIT=256

# Inside Docker, the video service reaches MinIO by container DNS.
VIDEO_MINIO_ENDPOINT=minio:9000
VIDEO_MINIO_SECURE=false

VIDEO_JOB_TIMEOUT_SECONDS=7200
VIDEO_DURABLE_RESULT_TTL_SECONDS=604800
VIDEO_CALLBACK_JOB_TIMEOUT_SECONDS=120
VIDEO_CALLBACK_MAX_ATTEMPTS=8
VIDEO_STALE_HEARTBEAT_SECONDS=180
VIDEO_MAX_STALE_WORK_REPLAYS=2
VIDEO_RESULT_TTL_SECONDS=86400
VIDEO_FAILURE_TTL_SECONDS=604800
VIDEO_MAX_DURATION_SECONDS=600
AOS_SHORTS_AUDIO_MIX_STALE_MINUTES=10
AOS_SHORTS_AUDIO_MIX_RECOVERY_BATCH_LIMIT=50
VIDEO_MAX_INPUT_BYTES=536870912
VIDEO_MAX_WIDTH=4096
VIDEO_MAX_HEIGHT=4096
VIDEO_MAX_PIXELS=16777216
VIDEO_MIN_ASPECT_RATIO=0.25
VIDEO_MAX_ASPECT_RATIO=4.0
VIDEO_ALLOWED_CODECS=h264,hevc,vp8,vp9,av1,mpeg4
VIDEO_FFPROBE_TIMEOUT_SECONDS=30
VIDEO_FFMPEG_TIMEOUT_SECONDS=3600
# Keep this aligned with the CPU limit per worker replica. Horizontal worker
# replicas provide concurrency; excessive FFmpeg threads per job cause noisy-neighbor contention.
VIDEO_FFMPEG_THREADS=2
# Optional additional hostnames permitted for callback delivery. The hostname in
# VIDEO_CALLBACK_URL (and FRAPPE_SITE_NAME when set) is always included automatically.
VIDEO_CALLBACK_ALLOWED_HOSTS=

# Automatic Shop/Geo/Vibes/Learn semantic content classification. These modes are
# derived from the Short itself and are independent of Ads, Localization, Maps, and location.
VIDEO_CLASSIFICATION_ENABLED=true
VIDEO_CLASSIFICATION_URL=http://image-search:8000/internal/shorts/classify-frames
VIDEO_CLASSIFICATION_ALLOWED_HOSTS=image-search
VIDEO_CLASSIFICATION_TIMEOUT_SECONDS=45
VIDEO_CLASSIFICATION_FRAME_COUNT=5
VIDEO_CLASSIFICATION_MAX_FRAME_BYTES=1048576


VIDEO_API_MEMORY_LIMIT=512m
VIDEO_API_CPU_LIMIT=1.00
VIDEO_API_PIDS_LIMIT=512
VIDEO_WORKER_MEMORY_LIMIT=3g
VIDEO_WORKER_CPU_LIMIT=2.00
VIDEO_WORKER_PIDS_LIMIT=1024
VIDEO_CALLBACK_WORKER_MEMORY_LIMIT=512m
VIDEO_CALLBACK_WORKER_CPU_LIMIT=0.50
VIDEO_CALLBACK_WORKER_PIDS_LIMIT=512


# CONTENT MODERATION SERVICE
# Moderation service is private and accessed by Frappe only.
MODERATION_ENABLED=true
MODERATION_FAIL_OPEN=false

MODERATION_SERVICE_BIND_ADDRESS=127.0.0.1
MODERATION_SERVICE_PORT=8140
MODERATION_SERVICE_URL=http://127.0.0.1:8140
MODERATION_SERVICE_NAME=aos-content-moderation
MODERATION_SERVICE_ENVIRONMENT=production
MODERATION_SERVICE_DEBUG=false

# Shared HMAC secrets. Use long random values in real .env.
MODERATION_SERVICE_SECRET=change-this-long-random-moderation-dispatch-secret
MODERATION_SERVICE_CALLBACK_SECRET=change-this-long-random-moderation-callback-secret

# Public callback URL the moderation worker can reach.
MODERATION_CALLBACK_URL=https://api.example.com/api/method/aos.api.internal.moderation.handle_callback

# Frappe dispatcher settings.
MODERATION_FRAPPE_QUEUE=long
MODERATION_SERVICE_REQUEST_TIMEOUT_SECONDS=20
MODERATION_DISPATCHER_TIMEOUT_SECONDS=300
MODERATION_MAX_RETRIES=3

# Moderation worker queue. This Redis belongs to the moderation service, not Frappe.
MODERATION_REDIS_URL=redis://moderation-redis:6379/0
MODERATION_QUEUE_NAME=moderation
MODERATION_REDIS_MAXMEMORY=256mb
MODERATION_REDIS_MEMORY_LIMIT=384m
MODERATION_REDIS_CPU_LIMIT=0.50
MODERATION_REDIS_PIDS_LIMIT=256

# Inside Docker, the moderation service reaches MinIO by container DNS.
MODERATION_MINIO_ENDPOINT=minio:9000
MODERATION_MINIO_SECURE=false

MODERATION_JOB_TIMEOUT_SECONDS=600
MODERATION_DURABLE_RESULT_TTL_SECONDS=604800
MODERATION_CALLBACK_JOB_TIMEOUT_SECONDS=120
MODERATION_CALLBACK_MAX_ATTEMPTS=8
MODERATION_RESULT_TTL_SECONDS=86400
MODERATION_FAILURE_TTL_SECONDS=604800
MODERATION_MAX_TEXT_CHARS=20000
MODERATION_MAX_REQUEST_BYTES=5242880
MODERATION_CALLBACK_ALLOWED_HOSTS=api.example.com
MODERATION_MAX_MEDIA_BYTES=10485760
MODERATION_INSPECT_MEDIA=true
MODERATION_POLICY_VERSION=aos-safety-2026-09-26-v5
MODERATION_MAX_IMAGES=8
MODERATION_MAX_TEXT_ITEMS=16
# Vision inference is private and authenticated. Current deployment reuses the
# self-hosted OpenCLIP runtime in image-search as a detector provider; AOS
# Moderation remains the policy/decision owner.
MODERATION_VISION_URL=http://image-search:8000/internal/moderation/classify-images
MODERATION_VISION_READY_URL=http://image-search:8000/internal/moderation/ready
MODERATION_VISION_ALLOWED_HOSTS=image-search
MODERATION_VISION_SECRET=change-this-to-the-same-value-as-short-classification-secret
MODERATION_VISION_TIMEOUT_SECONDS=45
# Source Media remains authoritative. Moderation creates an in-memory, metadata-free
# JPEG derivative for inference so valid multi-megabyte uploads are not forwarded
# unchanged to the model service.
MODERATION_VISION_MAX_IMAGE_BYTES=786432
MODERATION_VISION_MAX_TOTAL_BYTES=4194304
MODERATION_VISION_MAX_DIMENSION=1024
MODERATION_VISION_MAX_PIXELS=25000000

MODERATION_API_MEMORY_LIMIT=512m
MODERATION_API_CPU_LIMIT=1.00
MODERATION_API_PIDS_LIMIT=512
MODERATION_WORKER_MEMORY_LIMIT=1g
MODERATION_WORKER_CPU_LIMIT=1.00
MODERATION_WORKER_PIDS_LIMIT=512


# SEARCH / RANKING / RECOMMENDATION SERVICE
# Search-ranking service is private and accessed by Frappe only.
SEARCH_RANKING_ENABLED=true
SEARCH_RANKING_FAIL_OPEN=true
SEARCH_RANKING_USE_ADS_SEARCH=true
SEARCH_RANKING_USE_SHORTS_FEED=true

SEARCH_RANKING_SERVICE_BIND_ADDRESS=127.0.0.1
SEARCH_RANKING_SERVICE_PORT=8150
SEARCH_RANKING_SERVICE_URL=http://127.0.0.1:8150
SEARCH_RANKING_SERVICE_NAME=aos-search-ranking
SEARCH_RANKING_SERVICE_ENVIRONMENT=production
SEARCH_RANKING_SERVICE_DEBUG=false

# Shared HMAC secrets. Use long random values in real .env.
SEARCH_RANKING_SERVICE_SECRET=change-this-long-random-search-dispatch-secret
SEARCH_RANKING_SERVICE_CALLBACK_SECRET=change-this-long-random-search-callback-secret

# Public callback URL the search-ranking worker can reach.
SEARCH_RANKING_CALLBACK_URL=https://api.example.com/api/method/aos.api.v1.search_ranking.handle_callback

# Frappe dispatcher settings.
SEARCH_RANKING_FRAPPE_QUEUE=long
SEARCH_RANKING_SERVICE_REQUEST_TIMEOUT_SECONDS=20
SEARCH_RANKING_DISPATCHER_TIMEOUT_SECONDS=300
SEARCH_RANKING_MAX_RETRIES=3

# Search-ranking worker queue. This Redis belongs to the search-ranking service, not Frappe.
SEARCH_RANKING_REDIS_URL=redis://search-ranking-redis:6379/0
SEARCH_RANKING_QUEUE_NAME=search-ranking
SEARCH_RANKING_REDIS_MAXMEMORY=512mb
SEARCH_RANKING_REDIS_MEMORY_LIMIT=768m
SEARCH_RANKING_REDIS_CPU_LIMIT=0.50
SEARCH_RANKING_REDIS_PIDS_LIMIT=256

SEARCH_RANKING_JOB_TIMEOUT_SECONDS=600
SEARCH_RANKING_DURABLE_RESULT_TTL_SECONDS=604800
SEARCH_RANKING_CALLBACK_JOB_TIMEOUT_SECONDS=120
SEARCH_RANKING_CALLBACK_MAX_ATTEMPTS=8
SEARCH_RANKING_RESULT_TTL_SECONDS=86400
SEARCH_RANKING_FAILURE_TTL_SECONDS=604800
SEARCH_RANKING_MAX_AD_CANDIDATES=500
SEARCH_RANKING_MAX_SHORT_CANDIDATES=500
SEARCH_RANKING_TEXT_MATCH_WEIGHT=100
SEARCH_RANKING_RECENCY_WEIGHT=1

SEARCH_RANKING_API_MEMORY_LIMIT=512m
SEARCH_RANKING_API_CPU_LIMIT=1.00
SEARCH_RANKING_API_PIDS_LIMIT=512
SEARCH_RANKING_WORKER_MEMORY_LIMIT=1g
SEARCH_RANKING_WORKER_CPU_LIMIT=1.00
SEARCH_RANKING_WORKER_PIDS_LIMIT=512

# SHARED PRODUCTION FOUNDATION
# Development defaults are intentionally permissive. Production and staging
# validation reject placeholders, disabled safeguards, and example credential files.
AOS_ENVIRONMENT=development

# Prometheus/OpenMetrics endpoints stay loopback-only unless a long random bearer
# token is configured. Never reuse an application or worker signing secret.
AOS_METRICS_TOKEN=replace-with-long-random-metrics-token
AOS_METRICS_ALLOW_LOOPBACK=true
AOS_DISK_METRICS_PATH=/
# Redis-backed aggregation is mandatory in production. Change the prefix only
# for a planned metric epoch reset because counters under the old prefix remain.
AOS_METRICS_REDIS_PREFIX=aos:operational:metrics:v1
AOS_METRICS_ALLOW_PROCESS_FALLBACK=true

# Published outbox records are retried when no signed terminal callback arrives
# within this bounded deadline. Tune against the slowest approved worker SLA.
AOS_OUTBOX_CALLBACK_TIMEOUT_SECONDS=900
# Service-specific callback observation deadlines must exceed maximum work runtime plus 300 seconds.
AOS_VIDEO_CALLBACK_TIMEOUT_SECONDS=2700
AOS_MODERATION_CALLBACK_TIMEOUT_SECONDS=1200
AOS_SEARCH_CALLBACK_TIMEOUT_SECONDS=1200
AOS_NOTIFICATION_CALLBACK_TIMEOUT_SECONDS=1200
AOS_ANALYTICS_CALLBACK_TIMEOUT_SECONDS=1200

# Backup encryption settings must also be present in /etc/aos/backup.env for the
# systemd backup units. The age recipient is public; the identity file is secret
# and must never be stored in this repository or a container image.
BACKUP_ENCRYPTION_REQUIRED=false
BACKUP_ENCRYPTION_METHOD=none
BACKUP_AGE_RECIPIENT=
AGE_BINARY=age
BACKUP_LOCAL_RETENTION_MODE=encrypted-artifact
AOS_BACKUP_ENV_FILE=/etc/aos/backup.env

# Production requires an operator-configured backup failure route and deployable
# alerting. Keep webhook URLs and mail credentials outside source control.
AOS_ALERTING_ENABLED=false
BACKUP_FAILURE_NOTIFICATIONS_REQUIRED=false
BACKUP_FAILURE_NOTIFICATION_METHOD=
BACKUP_FAILURE_WEBHOOK_URL=
BACKUP_FAILURE_EMAIL_TO=

# Controlled deployment gates. Production requires both values to be true and a
# validated immutable release manifest supplied by the deployment workflow.
AOS_CD_ENABLED=false
AOS_RELEASE_MANIFEST_REQUIRED=false

# Migration preflight and sanitized previous-failure evidence.
AOS_MIGRATION_FAILURE_MARKER=/var/lib/aos/deployment/last-migration-failed.env
AOS_MIGRATION_MIN_FREE_GB=5
AOS_MIGRATION_LONG_TRANSACTION_SECONDS=300
AOS_MIGRATION_MAX_OUTBOX_BACKLOG=5000


# Semantic text moderation (v11). The model is pinned and mounted locally; production startup never downloads it.
TEXT_SAFETY_INTERNAL_SECRET=change-this-long-random-text-safety-secret
TEXT_SAFETY_BIND_ADDRESS=127.0.0.1
TEXT_SAFETY_PORT=8180
TEXT_SAFETY_MODEL_HOST_PATH=./models/multilingual-MiniLMv2-L6-mnli-xnli
TEXT_SAFETY_MODEL_NAME=multilingual-MiniLMv2-L6-mnli-xnli
TEXT_SAFETY_MODEL_REVISION=acf08db83390e23428c560cb578a865b39196993
TEXT_SAFETY_MODEL_VERSION=minilm-nli-v3
TEXT_SAFETY_MAX_ITEMS=16
TEXT_SAFETY_MAX_CHARS_PER_ITEM=6000
TEXT_SAFETY_MAX_TOKENS=256
TEXT_SAFETY_MAX_CONCURRENT_REQUESTS=2
TEXT_SAFETY_INTRA_OP_THREADS=2
TEXT_SAFETY_INTER_OP_THREADS=1
TEXT_SAFETY_EVIDENCE_FLOOR=0.05
TEXT_SAFETY_MEMORY_LIMIT=2g
TEXT_SAFETY_CPU_LIMIT=2.00
TEXT_SAFETY_PIDS_LIMIT=512
MODERATION_SEMANTIC_TEXT_ENABLED=true
MODERATION_SEMANTIC_TEXT_REQUIRED=true
MODERATION_SEMANTIC_TEXT_URL=http://text-safety:8000/internal/moderation/classify-text
MODERATION_SEMANTIC_TEXT_READY_URL=http://text-safety:8000/ready
MODERATION_SEMANTIC_TEXT_ALLOWED_HOSTS=text-safety
MODERATION_SEMANTIC_TEXT_TIMEOUT_SECONDS=8
TEXT_SAFETY_SERVICE_URL=http://127.0.0.1:8180
