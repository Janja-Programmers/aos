# AOS production backup configuration.
# Copy to /etc/aos/backup.env on the server and restrict permissions:
#   sudo install -m 600 infra/backup/backup.env.example /etc/aos/backup.env

AOS_REPO_ROOT=/home/aos/aos
FRAPPE_BENCH_ROOT=/home/aos/frappe-bench
FRAPPE_SITE=staging.aos

BACKUP_ROOT=/var/backups/aos
BACKUP_RETENTION_DAYS=14

# Docker Compose command executed from AOS_REPO_ROOT.
DOCKER_COMPOSE_COMMAND="docker compose"

# Stop stateful containers briefly before archiving Docker volumes.
QUIESCE_DOCKER_VOLUMES=true

# Volume backups.
INCLUDE_MINIO_DATA=true
INCLUDE_QDRANT_DATA=true
INCLUDE_NOMINATIM_DATA=false

# Generated map artifacts are reproducible but may be expensive to rebuild.
INCLUDE_MAP_ARTIFACTS=true

# Include local production configuration, but never commit the backup output.
INCLUDE_CONFIGURATION=true

# ---------------------------------------------------------------------------
# Offsite backup copy
# ---------------------------------------------------------------------------
# A backup stored only on the production server is not a disaster-recovery
# backup. Use exactly one supported mode: disabled, rsync, s3, or custom.
# The backup script only runs offsite copy after local verification succeeds.
# The offsite helper writes OFFSITE_SYNC_MARKER after a successful copy.

OFFSITE_BACKUP_MODE=disabled
OFFSITE_BACKUP_ENABLED=false
OFFSITE_SYNC_MARKER=/var/backups/aos/offsite-sync-passed.env
OFFSITE_MAX_SYNC_AGE_HOURS=26

# rsync/SSH mode, e.g. Hetzner Storage Box or another backup server.
# Recommended target format: user@host:/absolute/path/aos-backups
OFFSITE_RSYNC_TARGET=
OFFSITE_RSYNC_SSH_KEY=
OFFSITE_RSYNC_EXTRA_ARGS=

# S3-compatible mode. Install and configure AWS CLI credentials outside this
# file, or provide AWS_* variables via a root-only/systemd environment.
OFFSITE_S3_BUCKET=
OFFSITE_S3_PREFIX=aos-backups
OFFSITE_S3_ENDPOINT_URL=
OFFSITE_S3_STORAGE_CLASS=
OFFSITE_S3_EXTRA_ARGS=

# Custom mode for an audited local wrapper. The wrapper receives the completed
# backup directory as argv[1] and must exit non-zero on failure.
REMOTE_COPY_COMMAND=

# Legacy escape hatch for independently managed offsite backups. Prefer one of
# the modes above because readiness can verify its sync marker.
OFFSITE_BACKUP_CONFIGURED=false

# Optional marker written after a successful restore rehearsal on a clean test site.
# Used by aos.utils.backup_readiness.backup_readiness_summary.
RESTORE_REHEARSAL_MARKER=/var/backups/aos/restore-rehearsal-passed.env
