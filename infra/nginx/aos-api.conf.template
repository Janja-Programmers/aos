server {
    listen 80;
    listen [::]:80;

    server_name ${AOS_API_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;

        try_files $uri =404;

        access_log off;
        log_not_found off;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}


server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name ${AOS_API_DOMAIN};

    ssl_certificate
        /etc/letsencrypt/live/${AOS_API_DOMAIN}/fullchain.pem;

    ssl_certificate_key
        /etc/letsencrypt/live/${AOS_API_DOMAIN}/privkey.pem;

    include /etc/nginx/snippets/aos-ssl.conf;
    include /etc/nginx/snippets/aos-security-headers.conf;

    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;

        try_files $uri =404;

        access_log off;
        log_not_found off;
    }

    location /socket.io {
        include /etc/nginx/snippets/aos-proxy-common.conf;

        proxy_set_header Host ${FRAPPE_SITE_NAME};
        proxy_set_header X-Frappe-Site-Name ${FRAPPE_SITE_NAME};

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_buffering off;

        proxy_connect_timeout ${NGINX_PROXY_CONNECT_TIMEOUT};
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        proxy_pass
            http://${FRAPPE_SOCKETIO_HOST}:${FRAPPE_SOCKETIO_PORT};
    }

    error_page 429 = @aos_rate_limited;

    location @aos_rate_limited {
        default_type application/json;
        return 429 '{"message":{"ok":false,"message":"Too many requests.","error":"RATE_LIMIT","data":{}}}';
    }

    location ~ ^/api/method/aos\.api\.v1\..*handle_callback$ {
        # HMAC validation remains mandatory in Frappe. This edge limit bounds
        # invalid callback floods while allowing normal worker fan-out.
        limit_req zone=aos_signed_callback burst=200 nodelay;
        limit_req_status 429;

        include /etc/nginx/snippets/aos-proxy-common.conf;
        proxy_set_header Host ${FRAPPE_SITE_NAME};
        proxy_set_header X-Frappe-Site-Name ${FRAPPE_SITE_NAME};
        proxy_buffering off;
        proxy_connect_timeout ${NGINX_PROXY_CONNECT_TIMEOUT};
        proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT};
        proxy_send_timeout ${NGINX_PROXY_SEND_TIMEOUT};
        proxy_pass http://${FRAPPE_WEB_HOST}:${FRAPPE_WEB_PORT};
    }

    location /api/ {
        limit_req zone=aos_public_api_baseline burst=40 nodelay;
        limit_req_status 429;

        include /etc/nginx/snippets/aos-proxy-common.conf;
        proxy_set_header Host ${FRAPPE_SITE_NAME};
        proxy_set_header X-Frappe-Site-Name ${FRAPPE_SITE_NAME};
        proxy_buffering off;
        proxy_connect_timeout ${NGINX_PROXY_CONNECT_TIMEOUT};
        proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT};
        proxy_send_timeout ${NGINX_PROXY_SEND_TIMEOUT};
        proxy_pass http://${FRAPPE_WEB_HOST}:${FRAPPE_WEB_PORT};
    }

    location / {
        include /etc/nginx/snippets/aos-proxy-common.conf;

        # The public API hostname is not the Frappe site name.
        # Force Frappe to resolve the actual staging site.
        proxy_set_header Host ${FRAPPE_SITE_NAME};
        proxy_set_header X-Frappe-Site-Name ${FRAPPE_SITE_NAME};

        proxy_buffering off;

        proxy_connect_timeout ${NGINX_PROXY_CONNECT_TIMEOUT};
        proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT};
        proxy_send_timeout ${NGINX_PROXY_SEND_TIMEOUT};

        proxy_pass http://${FRAPPE_WEB_HOST}:${FRAPPE_WEB_PORT};
    }
}
