# AOS-managed Next.js web host. Certificate issuance is managed separately.
server {
    listen 80;
    listen [::]:80;
    server_name ${AOS_WEB_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
        access_log off;
        log_not_found off;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl${NGINX_HTTP2_LISTEN_OPTION};
    listen [::]:443 ssl${NGINX_HTTP2_LISTEN_OPTION};
    ${NGINX_HTTP2_DIRECTIVE}
    server_name ${AOS_WEB_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${AOS_WEB_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${AOS_WEB_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/aos-ssl.conf;

    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
