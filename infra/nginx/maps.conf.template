server {
    listen 80;
    listen [::]:80;
    server_name ${AOS_MAPS_DOMAIN};
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
        access_log off;
        log_not_found off;
    }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${AOS_MAPS_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${AOS_MAPS_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${AOS_MAPS_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/aos-ssl.conf;
    include /etc/nginx/snippets/aos-security-headers.conf;

    access_log /var/log/nginx/aos-maps.access.log;
    error_log /var/log/nginx/aos-maps.error.log warn;

    location = /healthz {
        access_log off;
        proxy_pass http://127.0.0.1:${MINIO_API_PORT}/minio/health/ready;
    }

    # A CDN should sit in front of this origin in production. Only immutable
    # basemap artifacts and the small current.json publication pointer are
    # exposed. MinIO itself remains bound to loopback/private infrastructure.
    location ^~ /basemap/ {
        limit_except GET HEAD OPTIONS { deny all; }
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Origin, Accept, Range, If-Range" always;
            add_header Access-Control-Max-Age 86400 always;
            return 204;
        }

        include /etc/nginx/snippets/aos-proxy-common.conf;
        proxy_connect_timeout ${NGINX_PROXY_CONNECT_TIMEOUT};
        proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT};
        proxy_send_timeout ${NGINX_PROXY_SEND_TIMEOUT};
        proxy_buffering on;
        proxy_force_ranges on;
        proxy_set_header Host 127.0.0.1:${MINIO_API_PORT};
        proxy_set_header Authorization "";
        proxy_hide_header Access-Control-Allow-Origin;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Expose-Headers "Accept-Ranges, Content-Length, Content-Range, ETag" always;
        proxy_pass http://127.0.0.1:${MINIO_API_PORT}/${MAPS_OBJECT_STORAGE_BUCKET}/basemap/;
    }

    location / { return 404; }
}
