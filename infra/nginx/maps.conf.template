server {
    listen 80;
    listen [::]:80;
    server_name ${AOS_MAPS_DOMAIN};
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${AOS_MAPS_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${AOS_MAPS_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${AOS_MAPS_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/aos-ssl.conf;
    include /etc/nginx/snippets/aos-security-headers.conf;

    access_log /var/log/nginx/aos-maps.access.log;
    error_log /var/log/nginx/aos-maps.error.log warn;

    location = /healthz {
        access_log off;
        proxy_pass http://127.0.0.1:${TILESERVER_PORT}/styles/aos/style.json;
    }

    location / {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Origin, Accept, Content-Type, Authorization" always;
            add_header Access-Control-Max-Age 86400 always;
            return 204;
        }

        include /etc/nginx/snippets/aos-proxy-common.conf;
        proxy_buffering on;
        proxy_cache_valid 200 1h;
        proxy_set_header Accept-Encoding "";
        add_header Access-Control-Allow-Origin "*" always;
        add_header Vary "Origin" always;
        proxy_pass http://127.0.0.1:${TILESERVER_PORT};
    }

    location ~* ^/(data|fonts|sprites)/ {
        include /etc/nginx/snippets/aos-proxy-common.conf;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "public, max-age=86400" always;
        expires 1d;
        proxy_pass http://127.0.0.1:${TILESERVER_PORT};
    }
}
