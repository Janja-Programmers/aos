server {
    listen 80;
    listen [::]:80;
    server_name ${AOS_LIVEKIT_DOMAIN};
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
        access_log off;
        log_not_found off;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl${NGINX_HTTP2_LISTEN_OPTION};
    listen [::]:443 ssl${NGINX_HTTP2_LISTEN_OPTION};
    ${NGINX_HTTP2_DIRECTIVE}
    server_name ${AOS_LIVEKIT_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${AOS_LIVEKIT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${AOS_LIVEKIT_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/aos-ssl.conf;
    include /etc/nginx/snippets/aos-security-headers.conf;

    access_log /var/log/nginx/aos-livekit.access.log;
    error_log /var/log/nginx/aos-livekit.error.log warn;

    location / {
        include /etc/nginx/snippets/aos-proxy-common.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout ${NGINX_PROXY_CONNECT_TIMEOUT};
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass http://127.0.0.1:${LIVEKIT_PORT};
    }
}
