{
  "options": {
    "paths": {
      "root": "/data",
      "styles": "styles",
      "mbtiles": "data",
      "fonts": "fonts"
    },
    "frontPage": false,
    "serveAllStyles": false,
    "serveAllFonts": true,
    "serveStaticMaps": false,
    "allowRemoteMarkerIcons": false,
    "allowInlineMarkerImages": false,
    "maxScaleFactor": 2,
    "maxSize": 1024,
    "tileMargin": 0,
    "staticAttributionText": "\u00a9 OpenStreetMap contributors"
  },
  "styles": {
    "aos": {
      "style": "aos/style.json",
      "serve_rendered": false,
      "serve_data": true,
      "tilejson": {
        "type": "baselayer",
        "bounds": [
          33.5,
          -5.2,
          42.2,
          5.7
        ]
      }
    }
  },
  "data": {
    "kenya": {
      "mbtiles": "kenya.mbtiles"
    },
    "aos_building_labels": {
      "mbtiles": "aos_building_labels.mbtiles"
    }
  }
}
