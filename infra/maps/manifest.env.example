# =============================================================================
# AOS MAP DATA MANIFEST
# =============================================================================
#
# Copy this file to:
#
#   infra/maps/manifest.env
#
# Then replace every placeholder checksum and immutable image digest.
#
# The real manifest.env is environment-specific and must not be committed.
# =============================================================================


# =============================================================================
# REGION
# =============================================================================

# Internal identifier used by the map build scripts.
MAP_REGION_ID=kenya

# Human-readable region name used in logs.
MAP_REGION_DISPLAY_NAME=Kenya

# Bounding box order:
# WEST,SOUTH,EAST,NORTH
#
# Kenya-wide coverage with a small buffer for border/coastal edge cases.
MAP_BBOX=33.50,-5.20,42.20,5.70

# Osmium extraction strategy.
#
# Kenya does not need extraction from the Kenya source PBF. This is kept for
# future country/region extraction support.
MAP_EXTRACT_STRATEGY=complete_ways


# =============================================================================
# SOURCE OSM DATA
# =============================================================================

# Kenya source extract.
#
# For strict reproducibility, prefer a dated or archived source URL instead
# of a moving "latest" URL.
KENYA_PBF_URL=https://download.geofabrik.de/africa/kenya-latest.osm.pbf

# Required SHA-256 checksum of the exact file from KENYA_PBF_URL.
#
# Must contain exactly 64 hexadecimal characters.
KENYA_PBF_SHA256=REPLACE_WITH_64_CHARACTER_SHA256

# Filename stored under:
#
#   maps/downloads/
KENYA_PBF_FILENAME=kenya.osm.pbf


# =============================================================================
# GENERATED / LIVE ARTIFACT FILENAMES
# =============================================================================

# Region PBF stored under:
#
#   maps/kenya/
REGION_PBF_FILENAME=kenya.osm.pbf

# Generated vector tile database stored under:
#
#   maps/tiles/
REGION_MBTILES_FILENAME=kenya.mbtiles


# =============================================================================
# OSMIUM
# =============================================================================

# Osmium runs from the host operating system.
#
# Install on Ubuntu with:
#
#   sudo apt install -y osmium-tool
#
# Verify with:
#
#   osmium --version
OSMIUM_COMMAND=osmium


# =============================================================================
# IMMUTABLE BUILD / RUNTIME IMAGES
# =============================================================================
#
# Every production image should use:
#
#   registry/image@sha256:<64-lowercase-hex-characters>
#
# Mutable tags such as "latest" are intentionally rejected by the build
# scripts. Docker Compose expects these values through .env.
# =============================================================================

# Used by build-kenya-tiles.sh.
PLANETILER_IMAGE=REPLACE_WITH_PINNED_PLANETILER_IMAGE_DIGEST

# Used by build-valhalla.sh and Valhalla runtime.
VALHALLA_IMAGE=REPLACE_WITH_PINNED_VALHALLA_IMAGE_DIGEST

# Used by Photon runtime/import tooling.
# Build with:
#   ./infra/maps/scripts/build-photon-image.sh
PHOTON_IMAGE=aos-photon@sha256:REPLACE_WITH_64_CHARACTER_IMAGE_DIGEST
PHOTON_JAR_SHA256=3455a6c2c9828393c2506d23540015b3b220cf00f4a9bb2c39e8007971cbe8c7


# =============================================================================
# PLANETILER BUILD SETTINGS
# =============================================================================

# Java heap limit used while generating MBTiles.
PLANETILER_JAVA_MEMORY=4g


# =============================================================================
# VALHALLA BUILD SETTINGS
# =============================================================================

# Number of threads used while generating routing tiles.
VALHALLA_BUILD_THREADS=2

# Name embedded in the generated Valhalla artifacts.
VALHALLA_TILESET_NAME=kenya_valhalla_tiles


# =============================================================================
# NOMINATIM IMPORT SETTINGS
# =============================================================================

# Docker Compose service name.
NOMINATIM_SERVICE=nominatim

# Explicit persistent Docker volume name from docker-compose.yml.
NOMINATIM_VOLUME=aos_nominatim_data

# Maximum time allowed for a fresh Nominatim import.
#
NOMINATIM_IMPORT_TIMEOUT_SECONDS=21600


# =============================================================================
# PHOTON IMPORT / INDEX SETTINGS
# =============================================================================

# Docker Compose service name.
PHOTON_SERVICE=photon

# Explicit persistent Docker volume name from docker-compose.yml.
PHOTON_VOLUME=aos_photon_data

# Maximum time allowed for Photon import/index build.
PHOTON_IMPORT_TIMEOUT_SECONDS=21600

# Prepared Photon archive source. Use exactly one of these:
#
# 1. PHOTON_DUMP_URL for a remote archive downloaded by import-photon.sh.
# 2. PHOTON_DUMP_LOCAL_PATH for an archive already copied to the server.
#
# Do not point production at an unversioned or mutable dump unless you also
# update PHOTON_DUMP_SHA256 for the exact downloaded file.
PHOTON_DUMP_URL=
PHOTON_DUMP_LOCAL_PATH=

# Filename stored under maps/downloads/ when PHOTON_DUMP_URL is used.
PHOTON_DUMP_FILENAME=photon-kenya.tar.gz

# Required SHA-256 checksum of the prepared Photon archive.
#
# Must contain exactly 64 hexadecimal characters.
PHOTON_DUMP_SHA256=REPLACE_WITH_64_CHARACTER_SHA256


# =============================================================================
# OPTIONAL SERVICE VERIFICATION PORTS
# =============================================================================
#
# Used by:
#
#   ./infra/maps/scripts/verify-map-data.sh --services
#
# These values should match .env and docker-compose.yml.
# =============================================================================

TILESERVER_PORT=8080
NOMINATIM_PORT=8081
PHOTON_PORT=2322
VALHALLA_PORT=8002
