# AOS global Maps data manifest. Copy to infra/maps/manifest.env; never commit the real file.
# Each operational job validates only the section it owns: Photon imports do not
# require basemap/Planetiler values, and basemap builds do not require Photon/Valhalla values.

# Immutable/reproducible OSM planet snapshot. Prefer a dated archive URL.
OSM_PLANET_URL=https://planet.openstreetmap.org/pbf/planet-YYYYMMDD.osm.pbf
OSM_PLANET_SHA256=REPLACE_WITH_64_CHARACTER_SHA256
OSM_PLANET_FILENAME=planet-YYYYMMDD.osm.pbf
MAP_DATA_VERSION=YYYYMMDD

# Global vector basemap artifact.
BASEMAP_PMTILES_FILENAME=aos-world.pmtiles
PLANETILER_IMAGE=ghcr.io/onthegomap/planetiler@sha256:afa51b803e0cb5be77165bc651cdf17a9cf6b01441fa32a873ef9632f18cc75c
PLANETILER_JAVA_MEMORY=64g
PLANETILER_TMP_DIR=maps/planetiler/tmp

# Photon runtime image. The repository currently pins the verified 1.2.0 jar checksum.
PHOTON_IMAGE=aos-photon:1.2.0
PHOTON_VERSION=1.2.0
PHOTON_JAR_SHA256=3455a6c2c9828393c2506d23540015b3b220cf00f4a9bb2c39e8007971cbe8c7
PHOTON_OPENSEARCH_VERSION=3.8.0

# Optional prepared Photon 1.x JSON dump used for blue/green reindexing.
PHOTON_DUMP_URL=
PHOTON_DUMP_LOCAL_PATH=
PHOTON_DUMP_FILENAME=photon-planet.jsonl.zst
PHOTON_DUMP_SHA256=REPLACE_WITH_64_CHARACTER_SHA256
PHOTON_IMPORT_TIMEOUT_SECONDS=86400
# Import jobs default to host networking for external production OpenSearch.
# Set to the private Compose network for a private Docker-hosted staging target.
PHOTON_IMPORT_DOCKER_NETWORK=host
# Optional filters for staging/sampled imports from a planet JSON dump. Empty means all countries/languages in the dump.
PHOTON_IMPORT_COUNTRY_CODES=
PHOTON_IMPORT_LANGUAGES=

# Global Valhalla routing build. Build from the same verified planet snapshot into
# an immutable maps/valhalla/releases/<MAP_DATA_VERSION> release.
VALHALLA_IMAGE=ghcr.io/valhalla/valhalla-scripted@sha256:bb3e89c0e8d3fb35e9278e23a1f7fdbcbf76d29c1edbf7effad829e1ee26b6ed
VALHALLA_BUILD_THREADS=8
VALHALLA_TILESET_NAME=aos_world_valhalla

# Publication target. Basemap objects are immutable and versioned; anonymous reads are opt-in.
MAPS_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9100
MAPS_OBJECT_STORAGE_BUCKET=aos-maps
MAPS_OBJECT_STORAGE_ALLOW_ANONYMOUS_READ=false
MAPS_OBJECT_STORAGE_REGION=us-east-1
MAPS_PUBLIC_BASE_URL=https://maps.example.com/basemap
