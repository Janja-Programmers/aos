[Unit]
Description=Verify the most recent AOS backup
After=local-fs.target

[Service]
Type=oneshot
User=aos
Group=aos
Environment=AOS_BACKUP_ENV_FILE=/etc/aos/backup.env
ExecStart=/bin/bash -lc 'source /etc/aos/backup.env; latest=$(find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d | sort | tail -1); test -n "$latest"; /home/aos/aos/infra/backup/verify-backup.sh "$latest"'
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/var/backups/aos /home/aos/aos
TimeoutStartSec=1h
